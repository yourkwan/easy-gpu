{
  "name": "easy-gpu",
  "displayName": "Easy GPU",
  "description": "监控远程 SSH 服务器的 GPU / CPU / 内存状态（gpustat 风格面板），支持各用户显存占用统计。",
  "version": "1.2.0",
  "publisher": "yourkwan",
  "icon": "media/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourkwan/easy-gpu"
  },
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "gpu",
    "gpustat",
    "nvidia",
    "ssh",
    "monitor"
  ],
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "easy-gpu",
          "title": "Easy GPU",
          "icon": "media/icon-activity.svg"
        }
      ]
    },
    "views": {
      "easy-gpu": [
        {
          "id": "easy-gpu.capsule",
          "name": "状态胶囊",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "easy-gpu.openDashboard",
        "title": "打开监控面板",
        "category": "Easy GPU"
      },
      {
        "command": "easy-gpu.connect",
        "title": "新建连接（输入服务器地址与用户名）",
        "category": "Easy GPU"
      },
      {
        "command": "easy-gpu.manageConnections",
        "title": "管理连接与密码",
        "category": "Easy GPU"
      },
      {
        "command": "easy-gpu.openSettings",
        "title": "设置",
        "category": "Easy GPU"
      },
      {
        "command": "easy-gpu.refreshNow",
        "title": "立即刷新",
        "category": "Easy GPU"
      }
    ],
    "configuration": {
      "title": "Easy GPU",
      "properties": {
        "easy-gpu.refreshInterval": {
          "type": "number",
          "default": 5,
          "minimum": 2,
          "maximum": 600,
          "markdownDescription": "自动刷新间隔（秒）：一次刷新结束后再等这么久开始下一次。"
        },
        "easy-gpu.mergeProcesses": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "把同一用户的多个进程合并成一条显示（显存合计），例如把 `wzs 6876M`、`wzs 6110M`、`wzs 3502M` 显示为 `wzs 16488M`。默认关闭，与 gpustat 一样逐个进程显示。"
        },
        "easy-gpu.accentColor": {
          "type": "string",
          "enum": ["blue", "cyan", "green", "purple", "pink", "orange", "red"],
          "default": "blue",
          "markdownDescription": "强调色风格：蓝 / 青 / 绿 / 紫 / 粉 / 橙 / 红，深浅主题自适应。"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -w -p ./",
    "package": "vsce package"
  },
  "dependencies": {
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@types/ssh2": "^1.15.6",
    "@types/vscode": "^1.74.0",
    "@vscode/vsce": "^3.2.1",
    "typescript": "^5.4.5"
  }
}
